{
  "name": "nixminds-document-suite",
  "version": "3.0.0",
  "description": "Nixminds Document Anonymization Suite - Production Ready with Offline Licensing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir",
    "test": "node test/test-python.js"
  },
  "author": {
    "name": "Nixminds",
    "email": "info@nixminds.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.nixminds.document-suite",
    "productName": "Nixminds Document Suite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "!test/**/*",
      "!.git/**/*",
      "!README.md",
      "!dist_obfuscated/**/*",
      "!backup_original/**/*",
      "!build_obfuscated.py",
      "!deploy_obfuscated.py",
      "!build_js_obfuscated.py",
      "!PYARMOR_README.md",
      "!RELEASE_NOTES.md",
      "!*.log",
      "!*_backup*",
      "!*_kopie*",
      "!debug_*.py",
      "!test_*.py",
      "!*_test.py",
      "validate_license_cli.py",
      "get_hw_id.py",
      "anonymize_cli.py",
      "deanonymizator_lokal.py",
      "pdf2docx_cli.py",
      "anon7.2 - s padama.py",
      "cz_names.v1.json",
      "licensing/**/*",
      "pyarmor_runtime_000000/**/*"
    ],
    "extraResources": [
      {
        "from": "python/",
        "to": "python/",
        "filter": ["**/*.py"]
      },
      {
        "from": "licensing/",
        "to": "licensing/",
        "filter": ["**/*"]
      },
      {
        "from": "pyarmor_runtime_000000/",
        "to": "pyarmor_runtime_000000/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": true,
      "runAfterFinish": true,
      "shortcutName": "Nixminds Document Suite",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "installerSidebar": "assets/icon.ico",
      "uninstallerSidebar": "assets/icon.ico",
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nixminds/document-suite.git"
  },
  "keywords": [
    "anonymization",
    "document-processing",
    "privacy",
    "czech",
    "gdpr",
    "pii"
  ]
}